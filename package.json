{
  "name": "lalph",
  "type": "module",
  "version": "0.3.140",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "lalph": "./dist/cli.mjs"
  },
  "scripts": {
    "prepare": "husky && effect-language-service patch",
    "check": "concurrently \"pnpm tsgo --noEmit\" \"pnpm oxlint -c .oxlintrc.json\" \"pnpm build\"",
    "build": "tsdown",
    "prepublishOnly": "pnpm build"
  },
  "files": [
    "dist",
    "src"
  ],
  "license": "MIT",
  "author": "Tim Smart <hello@timsmart.co>",
  "homepage": "https://github.com/tim-smart/lalph",
  "repository": {
    "type": "git",
    "url": "https://github.com/tim-smart/lalph.git"
  },
  "packageManager": "pnpm@10.28.0+sha512.05df71d1421f21399e053fde567cea34d446fa02c76571441bfc1c7956e98e363088982d940465fd34480d4d90a0668bc12362f8aa88000a64e83d0b0e47be48",
  "dependencies": {
    "tree-sitter": "^0.21.1",
    "tree-sitter-javascript": "^0.23.1",
    "tree-sitter-typescript": "^0.23.2"
  },
  "optionalDependencies": {
    "sqlite-vec-darwin-arm64": "0.1.9",
    "sqlite-vec-darwin-x64": "0.1.9",
    "sqlite-vec-linux-arm64": "0.1.9",
    "sqlite-vec-linux-x64": "0.1.9",
    "sqlite-vec-windows-x64": "0.1.9"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@effect/ai-openai": "4.0.3",
    "@effect/ai-openai-compat": "4.0.3",
    "@effect/language-service": "^0.86.4",
    "@effect/platform-node": "4.0.3",
    "@effect/sql-sqlite-node": "4.0.3",
    "@linear/sdk": "^88.0.0",
    "@octokit/plugin-rest-endpoint-methods": "^17.0.0",
    "@octokit/types": "^16.0.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "clanka": "^0.8.5",
    "concurrently": "^10.0.3",
    "effect": "4.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "octokit": "^5.0.5",
    "oxlint": "^1.73.0",
    "prettier": "^3.9.4",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3",
    "yaml": "^2.9.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxlint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@vscode/ripgrep",
      "tree-sitter",
      "tree-sitter-javascript",
      "tree-sitter-typescript"
    ]
  }
}
